{
  "name": "stitch_aicte_flowpilot_approval_dashboard",
  "version": "1.0.0",
  "description": "FlowPilot - AICTE regulatory approval dashboard",
  "main": "src/backend/server.ts",
  "scripts": {
    "start": "tsx src/backend/server.ts",
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/backend/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:vercel": "prisma generate --schema prisma/schema.postgres.prisma && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push && node -e \"console.log('First-run setup: http://localhost:5000/setup')\"",
    "db:use:sqlite": "node -e \"const fs=require('fs'); fs.copyFileSync('prisma/schema.sqlite.prisma','prisma/schema.prisma')\"",
    "db:use:postgres": "node -e \"const fs=require('fs'); fs.copyFileSync('prisma/schema.postgres.prisma','prisma/schema.prisma')\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:workflow": "playwright test --project=workflow",
    "test:e2e:a11y": "playwright test --project=accessibility"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
