PORT=5000

# Local development uses SQLite. For PostgreSQL use the URL below and run
# `npm run db:use:postgres` before `npm run db:setup`.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://flowpilot:flowpilot@localhost:5432/flowpilot"

# Must be at least 32 characters. Generate one, never commit a real value.
JWT_SECRET="replace-with-a-random-string-at-least-32-characters-long"
JWT_EXPIRES_IN="24h"

UPLOAD_DIR="uploads"
CORS_ORIGIN="http://localhost:5173"
ENABLE_SCHEDULER="true"
STAGE_SLA_DAYS="15"

# Login throttling: attempts per IP inside the window.
LOGIN_RATE_MAX="10"
LOGIN_RATE_WINDOW_MINUTES="15"

# Email is logged to the console unless SMTP_HOST is set.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
